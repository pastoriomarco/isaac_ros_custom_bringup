ARG BASE_IMAGE=ubuntu:24.04

FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# Isaac Sim manipulation tutorials recommend CycloneDDS.
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Install runtime deps (baked into the image) to match the manual transcript.
RUN --mount=type=cache,target=/var/cache/apt \
    set -euo pipefail; \
    apt-get update; \
    apt-get install -y \
      git \
      python3-colcon-common-extensions \
      python3-pip \
      python3-rosdep \
      ros-jazzy-rmw-cyclonedds-cpp; \
      ros-jazzy-isaac-manipulator-bringup \
    python3 -m pip install --break-system-packages cupy-cuda13x hdbscan; \
    rm -rf /var/lib/apt/lists/*

# Run the remaining workspace-scoped steps at container start (as the non-root user).
RUN mkdir -p /usr/local/bin/scripts/entrypoint_additions
COPY 90-isaac-manipulation-bootstrap.user.sh /usr/local/bin/scripts/entrypoint_additions/90-isaac-manipulation-bootstrap.user.sh
RUN chmod +x /usr/local/bin/scripts/entrypoint_additions/90-isaac-manipulation-bootstrap.user.sh

