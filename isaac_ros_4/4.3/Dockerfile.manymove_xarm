ARG BASE_IMAGE=ubuntu:24.04

FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
LABEL manymove_xarm_bootstrap_revision="2026-03-26-1"

RUN --mount=type=cache,target=/var/cache/apt \
    set -euo pipefail; \
    apt-get update; \
    apt-get install -y \
      bash-completion \
      build-essential \
      cmake \
      curl \
      git \
      libegl1 \
      libgl1-mesa-dri \
      libglu1-mesa \
      libglvnd0 \
      libglx-mesa0 \
      libqt5opengl5-dev \
      libqt5svg5-dev \
      libxcb-xinerama0 \
      libxkbcommon-x11-0 \
      libzmq3-dev \
      nano \
      python3-argcomplete \
      python3-colcon-common-extensions \
      python3-pip \
      python3-rosdep \
      python3-vcstool \
      qtbase5-dev \
      qttools5-dev-tools \
      ros-jazzy-backward-ros \
      ros-jazzy-behaviortree-cpp-v3 \
      ros-jazzy-camera-info-manager \
      ros-jazzy-control-msgs \
      ros-jazzy-control-toolbox \
      ros-jazzy-controller-manager \
      ros-jazzy-controller-manager-msgs \
      ros-jazzy-geometric-shapes \
      ros-jazzy-gripper-controllers \
      ros-jazzy-hardware-interface \
      ros-jazzy-isaac-ros-yolov8 \
      ros-jazzy-joint-state-broadcaster \
      ros-jazzy-joint-state-publisher-gui \
      ros-jazzy-joint-trajectory-controller \
      ros-jazzy-joy \
      ros-jazzy-launch-param-builder \
      ros-jazzy-moveit \
      ros-jazzy-moveit-core \
      ros-jazzy-moveit-msgs \
      ros-jazzy-moveit-resources-panda-moveit-config \
      ros-jazzy-moveit-ros-planning-interface \
      ros-jazzy-moveit-servo \
      ros-jazzy-robotiq-controllers \
      ros-jazzy-robotiq-description \
      ros-jazzy-ros2-controllers \
      ros-jazzy-simulation-interfaces \
      ros-jazzy-tf-transformations \
      ros-jazzy-ur \
      ros-jazzy-ur-moveit-config \
      ros-jazzy-vision-msgs \
      ros-jazzy-xacro; \
    rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/var/cache/apt \
    set -euo pipefail; \
    apt-get update; \
    if apt-cache show cppzmq-dev >/dev/null 2>&1; then \
      apt-get install -y cppzmq-dev; \
      rm -rf /var/lib/apt/lists/*; \
    else \
      apt-get install -y libzmq3-dev; \
      tmpdir="$(mktemp -d)"; \
      git clone --depth 1 https://github.com/zeromq/cppzmq.git "${tmpdir}/cppzmq"; \
      cmake -S "${tmpdir}/cppzmq" -B "${tmpdir}/build" -DCPPZMQ_BUILD_TESTS=OFF -DCMAKE_INSTALL_PREFIX=/usr; \
      cmake --build "${tmpdir}/build"; \
      cmake --install "${tmpdir}/build"; \
      rm -rf "${tmpdir}" /var/lib/apt/lists/*; \
    fi

RUN printf '%s\n' \
    'overlay_ws="${ISAAC_ROS_WS:-/workspaces/isaac_ros-dev}"' \
    'overlay_setup="${ISAAC_ROS_COLCON_INSTALL_BASE:-${overlay_ws}/install}/setup.bash"' \
    'if [ -f "${overlay_setup}" ]; then' \
    '  source "${overlay_setup}"' \
    'fi' \
    >> /etc/bash.bashrc

RUN mkdir -p /usr/local/bin/scripts/entrypoint_additions
COPY 91-manymove-xarm-bootstrap.user.sh /usr/local/bin/scripts/entrypoint_additions/91-manymove-xarm-bootstrap.user.sh
RUN chmod +x /usr/local/bin/scripts/entrypoint_additions/91-manymove-xarm-bootstrap.user.sh
