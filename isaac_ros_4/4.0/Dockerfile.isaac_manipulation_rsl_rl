ARG BASE_IMAGE=ubuntu:24.04
ARG ISAAC_MANIPULATION_RSL_RL_LAYER_REV=1

FROM ${BASE_IMAGE}

# Re-declare build args after FROM so they are available in this stage.
ARG ISAAC_MANIPULATION_RSL_RL_LAYER_REV=1

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# Cache-buster for this layer (so script changes get picked up by isaac-ros-cli's hash-based tags).
RUN echo "isaac_manipulation_rsl_rl layer rev: ${ISAAC_MANIPULATION_RSL_RL_LAYER_REV}" >/dev/null

# Optional RL dependencies (disabled by default; include this layer when needed).
RUN --mount=type=cache,target=/var/cache/apt \
    set -euo pipefail; \
    apt-get update; \
    apt-get install -y python3-git; \
    python3 -m pip install --break-system-packages tensordict; \
    python3 -m pip install --break-system-packages --no-deps rsl-rl-lib==3.1.1; \
    rm -rf /var/lib/apt/lists/*
